# ─────────────────────────────────────────────────────────────────────────────
#  Copy to .env.local (development) or set these in your host's dashboard
#  (production). NEVER commit a filled-in copy — .gitignore blocks every .env*
#  except this file.
#
#  Two kinds of variable live here, and the difference is not cosmetic:
#
#    SECRET   – server-only. Read exclusively inside src/lib/kamui/**, which is
#               marked `server-only` so a build FAILS rather than shipping it to
#               a browser. These must never be renamed to NEXT_PUBLIC_*.
#    PUBLIC   – NEXT_PUBLIC_* is inlined into browser JavaScript at build time.
#               Treat every value here as printed on the homepage.
# ─────────────────────────────────────────────────────────────────────────────


# ── SECRET ───────────────────────────────────────────────────────────────────

# Origin of the commerce API this storefront reads from. No trailing slash.
# Must be https in production — the API key travels in an Authorization header
# on every request, so plain http would put a credential on the wire.
# The app refuses to start serving with an http:// value when NODE_ENV=production.
KAMUI_API_BASE_URL=https://api.example.com

# ⚠️ SECRET — the store-scoped API key for THIS dispensary.
#
# What it can do if it leaks: read the entire catalog, place orders, redeem
# coupons, and send SMS on the store's account. It identifies the tenant by
# itself — there is no separate tenant id to send, and adding one would do
# nothing.
#
# Where it comes from: the store's own dashboard, Settings → API keys, minted
# with the "store" scope. See README.md § "Where the API key comes from".
#
# NEVER put this value in a NEXT_PUBLIC_* variable, a client component, or a
# committed file.
KAMUI_STORE_API_KEY=

# Per-request timeout, milliseconds. Clamped to 1000–60000; default 10000.
# KAMUI_API_TIMEOUT_MS=10000

# Public origin of THIS storefront, e.g. https://shop.example.com.
# Optional. Only needed when a reverse proxy rewrites the Host header, in which
# case the CSRF origin check needs to know the name browsers actually use.
# SITE_ORIGIN=https://shop.example.com


# ── PUBLIC (compiled into browser JavaScript) ────────────────────────────────

# Store name shown in the header, footer, page titles and the age gate.
# Falls back to the name configured in the commerce backend when unset.
NEXT_PUBLIC_SITE_NAME=YB Cannabis Co.

# One-line pitch under the hero heading.
NEXT_PUBLIC_SITE_TAGLINE=Same-day cannabis delivery, paid at the door.

# Minimum legal age used before the backend's own setting has loaded.
NEXT_PUBLIC_MIN_AGE=21
